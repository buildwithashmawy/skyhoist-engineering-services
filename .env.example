# Certificate portal (set these in Vercel → Settings → Environment Variables)
CERT_ADMIN_USERNAME=admin
CERT_ADMIN_PASSWORD=replace-with-a-strong-password
CERT_ADMIN_EMAIL=admin@skyhoistservices.com
CERT_SESSION_SECRET=replace-with-a-long-random-secret

# Firebase (required on Vercel so login/data survive across instances)
# Project: skyhoist-engineering
# Prefer the single JSON var (paste the full service-account JSON as one line):
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"skyhoist-engineering","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@skyhoist-engineering.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_STORAGE_BUCKET=skyhoist-engineering.firebasestorage.app
FIREBASE_UPLOAD_BACKEND=storage

# Or split vars instead of FIREBASE_SERVICE_ACCOUNT_JSON:
# FIREBASE_PROJECT_ID=skyhoist-engineering
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@skyhoist-engineering.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
